# Spring Boot Active Profile (dev, prod)
SPRING_PROFILES_ACTIVE=dev

# Server Port
PORT=8080

# Database Configuration (Aiven MySQL / Local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=onlinelearningportal
DB_USERNAME=your_mysql_username
DB_PASSWORD=replace_with_your_mysql_password
DB_SSL_MODE=REQUIRED

# Security & JWT Configuration
JWT_SECRET=replace_with_a_long_random_secret_of_sufficient_entropy_min_32_bytes
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Configuration (Comma-separated origins)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://ai-powered-personalized-online-lear.vercel.app

# AI Assistant Provider Configuration (mock, openai, gemini)
AI_MODE=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_BASE_URL=https://api.openai.com/v1

# Logging Level
APP_LOG_LEVEL=INFO
